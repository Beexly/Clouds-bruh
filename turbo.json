{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "STORE_CORS",
    "ADMIN_CORS",
    "AUTH_CORS",
    "MEDUSA_*",
    "ANTHROPIC_*",
    "CLAUDE_*",
    "LLM_*",
    "SHEPHERD_*",
    "EMBEDDING_*",
    "COCKPIT_*",
    "STRIPE_*",
    "PAYPAL_*",
    "PRINTIFY_*",
    "PRINTFUL_*",
    "CJ_*",
    "SPOCKET_*",
    "SYNCEE_*",
    "MODALYST_*",
    "DROPIFIED_*",
    "VENDOR_*",
    "AUTO_*",
    "MANUAL_*",
    "DEFAULT_*",
    "SUPPLIER_*",
    "MAX_*",
    "LUMERA_*",
    "S3_*",
    "RESEND_*",
    "SENDGRID_*",
    "NOTIFICATION_*",
    "OXYLABS_*",
    "APIFY_*",
    "HIGGSFIELD_*",
    "RATE_LIMIT_*",
    "SHOPIFY_*",
    "WOOCOMMERCE_*",
    "ETSY_*",
    "AMAZON_*",
    "CHANNEL_*",
    "SOLANA_*"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".medusa/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "seed": { "cache": false },
    "bootstrap": { "cache": false },
    "test": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] }
  }
}
