{
  "name": "alter-xiv",
  "private": true,
  "version": "0.1.0",
  "description": "Alter XIV — intelligent drop-culture commerce platform. The Broadcast.",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "seed": "turbo run seed --filter=backend",
    "bootstrap": "turbo run bootstrap --filter=backend",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:regression": "tsx scripts/api-regression.ts",
    "lint": "turbo run lint",
    "verify:api": "bash scripts/verify-api.sh"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.1",
      "@types/react-dom": "^18.3.1"
    }
  }
}
