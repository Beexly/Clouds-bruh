{
  "name": "lumera",
  "private": true,
  "version": "0.1.0",
  "description": "Lumera — autonomous luxury commerce platform. The Broadcast.",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "seed": "turbo run seed --filter=backend",
    "bootstrap": "turbo run bootstrap --filter=backend",
    "backup": "tsx scripts/backup.ts",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:regression": "tsx scripts/api-regression.ts",
    "preflight": "tsx scripts/preflight.ts",
    "vendor:preflight": "tsx scripts/vendor-preflight.ts",
    "vendor:test": "tsx scripts/vendor-test.ts",
    "owner:actions": "tsx scripts/owner-actions.ts",
    "curation:e2e": "tsx scripts/curation-e2e.ts",
    "fulfillment:sandbox": "tsx scripts/fulfillment-sandbox.ts",
    "vendor-orders:submit": "tsx scripts/vendor-order-submit.ts",
    "launch:proof": "tsx scripts/launch-proof.ts",
    "curate": "tsx scripts/curate.ts",
    "radar": "tsx scripts/radar.ts",
    "publish:approved": "tsx scripts/publish-approved.ts",
    "fulfillment:drill": "tsx scripts/fulfillment-drill.ts",
    "launch:preflight": "tsx scripts/launch-preflight.ts",
    "lint": "turbo run lint",
    "verify:api": "bash scripts/verify-api.sh"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.1",
      "@types/react-dom": "^18.3.1"
    }
  }
}
