# ── Core ───────────────────────────────────────────────
DATABASE_URL=postgres://lumera:lumera@localhost:5432/lumera
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# ── Medusa ─────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
# Browser-exposed Medusa store URL (storefront fetches: catalog, signals, auth, customer, orders).
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
JWT_SECRET=change_me
COOKIE_SECRET=change_me
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
# Generated by `medusa user -e admin@lumera.com -p <password>` then create API key in admin
PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_SITE_URL=https://lumeralabel.com
# Comma-separated authoritative profile URLs for the Organization JSON-LD `sameAs` (knowledge panel).
# Leave empty until the real, on-brand accounts exist — placeholder handles must not ship.
NEXT_PUBLIC_SOCIAL_LINKS=

# ── AI / Intelligence ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8        # agents + self-audit
EMBEDDING_DIM=1536

# ── LLM provider (optional: free/cheap alternative to Anthropic) ──
# Polaris (the concierge) is the one AI cost that scales with traffic. Setting LLM_BASE_URL +
# LLM_API_KEY points it at ANY OpenAI-compatible /chat/completions endpoint (e.g. a free Groq or
# OpenRouter model, Together, Cerebras, Google Gemini OpenAI-compat, or a local Ollama) at ~$0 —
# without losing the Anthropic default. When set, this takes priority over ANTHROPIC_API_KEY FOR
# THE CONCIERGE ONLY; the autonomous agents still run on ANTHROPIC_API_KEY/CLAUDE_MODEL.
# Leave both blank to keep today's behavior exactly (Anthropic when keyed, else a scripted reply).
LLM_BASE_URL=                       # e.g. https://api.groq.com/openai/v1  (base URL, no /chat/completions)
LLM_API_KEY=
LLM_MODEL=                          # OpenAI-compat model id; defaults to gpt-4o-mini when unset
SHEPHERD_MODEL=                     # optional: pin a cheaper model for the concierge only
# Open-weight text models (Qwen3-235B, Kimi-K2, GLM-5.x, etc.) plug in here — they are served
# behind OpenAI-compatible endpoints (OpenRouter/Together/Groq/DeepInfra/local vLLM), so set
# LLM_BASE_URL + LLM_API_KEY + LLM_MODEL to that model id. No code change needed. See docs/LUMERA_AI_LAYER.md.

# ── Imagery (Artisan) ──────────────────────────────────
HIGGSFIELD_API_KEY=

# ── AR virtual try-on (optional; gated — feature hidden until configured) ──
# Any of these provider pairs enables POST /store/tryon (precedence: IDM-VTON → Kolors → generic).
# The adapter (apps/backend/src/lib/tryon.ts) posts person+garment image URLs and returns a rendered
# image or a job id. Adjust the request field mapping to your provider's contract.
IDM_VTON_API_URL=                   # IDM-VTON HTTP endpoint base
IDM_VTON_API_KEY=
KOLORS_API_URL=                     # Kwai Kolors virtual try-on endpoint base
KOLORS_API_KEY=
TRYON_API_URL=                      # any generic OpenAI-style try-on endpoint base
TRYON_API_KEY=
TRYON_TIMEOUT_MS=                   # per-request timeout (default 45000)

# ── Data radar (managed scraping for AliExpress/Alibaba/Shein discovery) ──
OXYLABS_USER=
OXYLABS_PASS=
APIFY_TOKEN=
# Per-source Apify Actor overrides (optional; defaults target community AliExpress actors)
APIFY_ALIEXPRESS_ACTOR=
APIFY_ALIBABA_ACTOR=
APIFY_SHEIN_ACTOR=
APIFY_AMAZON_ACTOR=
# Curation radar tuning
LUMERA_RADAR_SOURCE=aliexpress
LUMERA_RADAR_LIMIT=8
LUMERA_RADAR_FULFILLMENT=manual
# Comma-separated discovery queries; defaults to a built-in on-brand seed set
LUMERA_RADAR_QUERIES=

# Vendor curation / fulfillment
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=
CJ_EMAIL=
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_WEBHOOK_SECRET=
CJ_SANDBOX=true
# SaaS dropship bridges (catalog/inventory; order placement is bridge-managed)
SPOCKET_API_KEY=
SPOCKET_API_URL=
SYNCEE_API_KEY=
SYNCEE_API_URL=
MODALYST_API_KEY=
MODALYST_API_URL=
DROPIFIED_API_KEY=
DROPIFIED_API_URL=
VENDOR_LIVE_MODE=false
AUTO_PUBLISH_APPROVED=true
AUTO_SUBMIT_VENDOR_ORDERS=false
VENDOR_DRAFT_ORDER_PROOF=false
DEFAULT_FULFILLMENT_VENDOR=manual
MANUAL_SUPPLIER_VERIFIED=false
# Route checkout through the native Lumera dropship fulfillment provider (else manual_manual)
LUMERA_NATIVE_FULFILLMENT=false
SUPPLIER_MARGIN_FLOOR=0.38
MAX_SHIPPING_DAYS=12
MEDUSA_ADMIN_API_TOKEN=
LUMERA_SALES_CHANNEL_ID=
LUMERA_SHIPPING_PROFILE_ID=

# ── Outbound sales channels ────────────────────────────
# Push Lumera products OUT to external marketplaces. Listings stay gated: no live listing is
# created unless CHANNEL_LIVE_MODE=true AND the channel's credentials are present.
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
WOOCOMMERCE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
# Amazon SP-API (SigV4 signing not implemented; listing stays gated as requires_sp_api_auth)
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_SELLER_ID=
AMAZON_SP_ACCESS_TOKEN=
CHANNEL_LIVE_MODE=false

# ── Payments ───────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: hold funds instead of capturing on authorization (capture manually from admin).
STRIPE_MANUAL_CAPTURE=
# Optional web3 (Phase 3+)
SOLANA_RPC_URL=

# ── Asset storage (MinIO/S3) ───────────────────────────
# Leave S3_FILE_URL empty to use local disk. Set all to use MinIO (S3-compatible):
S3_FILE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=lumera

# ── Security / hardening ───────────────────────────────
# Per-IP rate limiting (in-memory; front with Redis for multi-instance). Generous defaults so CI/dev
# are never throttled — tighten in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_OPS_MAX=120
RATE_LIMIT_DISABLED=false

# ── Observability & email ──────────────────────────────
# All optional. Everything no-ops cleanly when unset.
# Backend Sentry (error reporting via fetch envelope): https://{publicKey}@{host}/{projectId}
SENTRY_DSN=
# Storefront monitoring + analytics (NEXT_PUBLIC_* are exposed to the browser):
NEXT_PUBLIC_SENTRY_DSN=
# Pick ONE product analytics tool:
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
# GDPR cookie consent gate: analytics scripts load ONLY after the visitor accepts in the
# consent banner. Set to 'false' to disable the gate (e.g. regions where consent is handled
# elsewhere). Anything other than 'false' (or unset) keeps the gate ON by default.
NEXT_PUBLIC_CONSENT_REQUIRED=
# Transactional email (Resend) — set both to actually send order confirmations:
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
# Lifecycle events (Klaviyo "Placed Order" + "Fulfilled Order" / shipped flows):
KLAVIYO_API_KEY=
KLAVIYO_API_REVISION=2024-10-15
# Abandoned-cart recovery (hourly job). OFF by default so it never sends unexpectedly; the job also
# no-ops without DATABASE_URL, and emails mock-until-keyed (RESEND_API_KEY). Optional window tuning
# (hours): how long a cart must be idle before / until it's still worth recovering. Dedup is 24h.
ABANDONED_CART_ENABLED=false
ABANDONED_CART_MIN_AGE_HOURS=1
ABANDONED_CART_MAX_AGE_HOURS=72
# Post-purchase review request (daily job). OFF by default; no-ops without DATABASE_URL; emails
# mock-until-keyed (RESEND_API_KEY). Asks ONCE per order (permanent dedup). DELAY_DAYS should sit
# above your typical shipping time so the ask never lands before the piece does.
REVIEW_REQUEST_ENABLED=false
REVIEW_REQUEST_DELAY_DAYS=7
REVIEW_REQUEST_MAX_DAYS=45
# Drop grader (daily job) — the deterministic LATR loop. OFF by default; no-ops without DATABASE_URL.
# Grades live drops and files restock/kill PROPOSALS into the founder approval inbox (cockpit). It
# never executes — the founder approves each; deduped so a drop only sits in the inbox once.
DROP_GRADER_ENABLED=false

# ── Shipping rates & PayPal ────────────────────────────
# Live carrier rating for the Lumera fulfillment provider. With NEITHER key set, calculatePrice falls
# back to a flat rate (LUMERA_FLAT_SHIPPING_USD) and no carrier API is called. EasyPost takes precedence.
EASYPOST_API_KEY=
SHIPPO_API_KEY=
LUMERA_FLAT_SHIPPING_USD=0
# Ship-from origin for live carrier quotes (sensible US defaults when unset)
SHIP_FROM_POSTAL=
SHIP_FROM_COUNTRY=US
# PayPal Orders v2 payment provider (activated in medusa-config only when PAYPAL_CLIENT_ID is set).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Storefront-side PayPal client id. When set (AND the backend PayPal provider is enabled for the
# region), checkout offers PayPal Smart Buttons (loaded from the PayPal CDN); otherwise checkout
# keeps the pp_system_default test flow. Safe to expose — it is a public client id.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Stripe Elements card rail (storefront). Render-gated: form appears only when this is set AND the
# backend Stripe provider is enabled for the region (STRIPE_API_KEY on the backend).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Launch hardening (trust, compliance, security) ─────
# CAN-SPAM: physical postal address printed in every MARKETING email (abandoned-cart, review-request).
# REQUIRED in production — without it those marketing jobs skip the run rather than send a
# non-compliant email. Transactional mail (order/shipment) is exempt and never shows it.
COMPANY_POSTAL_ADDRESS=
# Secret used to sign one-click unsubscribe links (HMAC). Falls back to COCKPIT_KEY, then a dev-only
# constant. Set a real random value in production: `openssl rand -hex 32`.
UNSUBSCRIBE_SECRET=
# Force the cockpit/approvals/analyst ops APIs to require COCKPIT_KEY even outside production. Set to
# 'true' on any internet-reachable staging/preview deploy so unkeyed ops APIs are never exposed there.
COCKPIT_REQUIRE_KEY=false
# Require a verified purchase (matching order + email) before a product review is published, so the
# AggregateRating can't be inflated by non-buyers. Defaults to ON in production; set 'false' to allow
# open reviews, or 'true' to enforce everywhere.
REVIEWS_REQUIRE_VERIFIED_PURCHASE=
