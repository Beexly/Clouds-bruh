# ── Core ───────────────────────────────────────────────
DATABASE_URL=postgres://alterxiv:alterxiv@localhost:5432/alterxiv
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# ── Medusa ─────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://localhost:9000
JWT_SECRET=change_me
COOKIE_SECRET=change_me
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
# Generated by `medusa user -e admin@alterxiv.com -p <password>` then create API key in admin
PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
NEXT_PUBLIC_SITE_URL=https://lumera.example

# ── AI / Intelligence ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8        # agents + self-audit
EMBEDDING_DIM=1536

# ── Imagery (Artisan) ──────────────────────────────────
HIGGSFIELD_API_KEY=

# ── Data radar ─────────────────────────────────────────
OXYLABS_USER=
OXYLABS_PASS=
APIFY_TOKEN=

# Vendor curation / fulfillment
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=
CJ_EMAIL=
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_WEBHOOK_SECRET=
CJ_SANDBOX=true
VENDOR_LIVE_MODE=false
AUTO_PUBLISH_APPROVED=true
AUTO_SUBMIT_VENDOR_ORDERS=false
VENDOR_DRAFT_ORDER_PROOF=false
DEFAULT_FULFILLMENT_VENDOR=manual
MANUAL_SUPPLIER_VERIFIED=false
SUPPLIER_MARGIN_FLOOR=0.38
MAX_SHIPPING_DAYS=12
MEDUSA_ADMIN_API_TOKEN=
LUMERA_SALES_CHANNEL_ID=
LUMERA_SHIPPING_PROFILE_ID=

# ── Payments ───────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional web3 (Phase 3+)
SOLANA_RPC_URL=

# ── Asset storage (MinIO/S3) ───────────────────────────
# Leave S3_FILE_URL empty to use local disk. Set all to use MinIO (S3-compatible):
S3_FILE_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=lumera
