# Altar XIV — environment variable NAMES only. No values. Copy to .env to use live mode.
# v1 runs fully offline with mock adapters. Live adapters are imported ONLY when ALTAR_LIVE=1.

# Master switch. Unset/0 = mock everything, no network, no secrets needed.
ALTAR_LIVE=0

# GitHub mirror (Phase 2) — one issue per review-queue candidate
GITHUB_TOKEN=
GITHUB_REPO=beexly/clouds-bruh

# Image/video generation (Phase 3) — real product media
IMAGEGEN_API_KEY=

# Stripe (Phase 4) — TEST mode first; going live is a deliberate, documented flip
STRIPE_SECRET_KEY=
STRIPE_MODE=test

# Notion / Google Drive asset mirror (optional, Phase 3)
NOTION_TOKEN=
NOTION_DB_ID=
