{
  "project": "Lumera Autonomous Dropshipping",
  "repo": "Clouds-bruh",
  "branch": "deploy/medusa-cloud",
  "commands": {
    "health": ["pnpm test", "pnpm lint", "pnpm build"],
    "commerce_preflight": "pnpm preflight",
    "commerce_preflight_live": "pnpm preflight -- --live",
    "vendor_preflight": "pnpm vendor:preflight",
    "vendor_test": "pnpm vendor:test",
    "owner_actions": "pnpm owner:actions",
    "owner_actions_live": "pnpm owner:actions -- --live",
    "curate": "pnpm curate -- --force",
    "publish_approved": "pnpm publish:approved",
    "fulfillment_sandbox": "pnpm fulfillment:sandbox",
    "vendor_orders_submit": "pnpm vendor-orders:submit",
    "curation_e2e": "pnpm curation:e2e",
    "launch_proof": "pnpm launch:proof"
  },
  "env_required_for_live": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "STORE_CORS",
    "ADMIN_CORS",
    "MEDUSA_ADMIN_API_TOKEN",
    "LUMERA_SALES_CHANNEL_ID",
    "LUMERA_SHIPPING_PROFILE_ID",
    "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY",
    "STRIPE_API_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "PRINTIFY_TOKEN",
    "PRINTIFY_SHOP_ID",
    "PRINTIFY_WEBHOOK_SECRET",
    "PRINTFUL_TOKEN",
    "PRINTFUL_STORE_ID",
    "PRINTFUL_WEBHOOK_SECRET",
    "CJ_API_KEY",
    "CJ_ACCESS_TOKEN",
    "CJ_WEBHOOK_SECRET",
    "VENDOR_DRAFT_ORDER_PROOF",
    "COCKPIT_KEY"
  ],
  "owner_only_actions": [
    "enable VENDOR_LIVE_MODE",
    "enable AUTO_SUBMIT_VENDOR_ORDERS",
    "approve product publishing",
    "approve sample purchases",
    "approve refunds",
    "approve price changes",
    "approve live campaign spend",
    "supply production secrets"
  ],
  "launch_blockers": [
    "fixture-only vendor data",
    "missing Medusa admin token",
    "missing vendor credentials",
    "Stripe test key while vendor live mode is true",
    "legal placeholders",
    "failed sandbox fulfillment proof",
    "failed build/lint/test"
  ],
  "proof_layers": [
    "tests",
    "lint",
    "build",
    "commerce preflight",
    "vendor preflight",
    "vendor test",
    "curation board",
    "publish proof",
    "fulfillment proof",
    "legal proof"
  ]
}
