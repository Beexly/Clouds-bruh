# Storefront (The Broadcast) — local env template.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored on purpose: Next.js loads it with
# HIGH precedence, so a committed copy pointing at localhost would override production env on deploy
# and silently break all data/checkout. Keep real values out of git.

# Server-side base URL the storefront uses to reach the Medusa backend.
MEDUSA_BACKEND_URL=http://localhost:9000

# Browser-exposed Medusa store URL (catalog, signals, auth, customer, orders).
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000

# Medusa publishable API key (browser-exposed, not a secret). Generate in Medusa admin and paste here.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxx

# Optional: real payment rails (else checkout uses the safe pp_system_default test flow — no real charge).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional: comma-separated authoritative social profile URLs for the Organization JSON-LD `sameAs`.
# Leave empty until the real on-brand accounts exist — placeholder handles must not ship.
# NEXT_PUBLIC_SOCIAL_LINKS=
